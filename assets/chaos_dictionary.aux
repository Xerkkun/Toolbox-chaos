\@writefile{toc}{\contentsline {section}{\numberline {5}Funciones y logica metodologica}{20}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Simulacion y seleccion de trayectorias}{20}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces Ejemplo original conservado: atractor de Lorenz con \(\sigma =10,\rho =28,\beta =8/3\). Esta grafica sirve como referencia visual de trayectoria acotada no periodica: la orbita no converge a un punto, sino que visita dos lobulos con alternancia irregular.}}{21}{figure.33}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Diagramas de bifurcacion}{21}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces Ejemplo original conservado: diagrama de bifurcacion del mapa logistico. Para cada valor de \(r\) se descartan iteraciones transitorias y se grafican valores asintoticos de \(x_n\). Una sola rama indica punto fijo, dos ramas indican periodo 2, duplicaciones sucesivas indican cascada de periodo y las nubes densas corresponden a regimenes caoticos o ventanas periodicas inmersas.}}{22}{figure.34}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Cuencas y clasificacion de comportamiento}{22}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {35}{\ignorespaces Ejemplo original conservado: cuenca rapida de Lorenz en el plano \(z_0=1\), ventana lejana \([-60,60]\times [-60,60]\). La leyenda representa las clases operacionales disponibles para este caso: caotico, converge a \(E_+\) y converge a \(E_-\).}}{23}{figure.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {36}{\ignorespaces Ejemplo original conservado: trayectorias iniciadas en regiones distintas de la cuenca de Lorenz. Las condiciones iniciales en zonas rojas y verdes se acercan a vecindades de equilibrios simetricos, mientras que la condicion en la zona azul permanece acotada con recorrido irregular y se clasifica como caotica por el clasificador rapido.}}{24}{figure.36}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Analisis espectral y FFT}{24}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {37}{\ignorespaces Ejemplo FFT para Lorenz con lineas verticales y eje \(x\) recortado alrededor de las frecuencias dominantes. La presencia de energia distribuida en varias frecuencias es consistente con dinamica irregular, pero debe contrastarse con secciones, cuencas y exponentes de Lyapunov.}}{25}{figure.37}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Exponentes de Lyapunov y metodo de Benettin}{25}{subsection.5.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {38}{\ignorespaces Ejemplo original conservado: estimacion finita de exponentes de Lyapunov para Lorenz por QR-Benettin. La lectura esperada en el regimen clasico es una direccion expansiva, una casi neutra asociada al flujo y una contractiva; la convergencia debe evaluarse por estabilidad temporal, no por un unico valor instantaneo.}}{26}{figure.38}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Autovalores y clasificacion local}{26}{subsection.5.6}\protected@file@percent }
