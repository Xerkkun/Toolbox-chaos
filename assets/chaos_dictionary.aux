\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Euler explicito}{20}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Heun / Euler mejorado}{20}{subsection.4.2}\protected@file@percent }
